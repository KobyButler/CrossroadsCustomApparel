generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Product {
  id               String      @id @default(cuid())
  name             String
  sku              String      @unique
  vendor           String      @default("OTHER")
  vendorIdentifier String?
  brand            String?
  description      String?
  priceCents       Int
  imagesJson       String?   // JSON array of image URLs, in display order
  sizesJson        String?   // JSON array of strings, e.g. ["S","M","L","XL","2XL"]
  colorsJson       String?   // JSON array of strings, e.g. ["Black","White","Navy"]
  sizeChartUrl     String?   // link to a PDF (or image) sizing chart for this product
  upchargeEnabled  Boolean     @default(false) // charge extra for larger sizes (2XL and up)
  upchargeCents    Int         @default(300)
  weightOz         Int?        // shipping weight in ounces; falls back to a default estimate when unset
  orderItems       OrderItem[]
  shops            Shop[]      @relation("ShopProducts")
  createdAt        DateTime    @default(now())
}

model Shop {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  active           Boolean    @default(true)
  shippingEnabled  Boolean    @default(true) // whether customers may choose "Ship to you" for this shop
  expiresAt        DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  orders           Order[]
  checkouts        Checkout[]
  products         Product[]  @relation("ShopProducts")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id                    String               @id @default(cuid())
  shopId                String?
  shop                  Shop?                @relation(fields: [shopId], references: [id])
  orderGroupId          String?              // shared by orders split across shops from one multi-shop checkout
  customerId            String?
  customer              Customer?            @relation(fields: [customerId], references: [id])
  status                String               @default("UNFULFILLED") // UNFULFILLED|FULFILLED|CANCELLED|DRAFT
  paymentStatus         String               @default("UNPAID")      // UNPAID|PAID|OFFLINE_PENDING
  paymentMethod         String?                                       // stripe|cash|check
  stripePaymentIntentId String?
  customerName          String
  customerEmail         String
  shippingMethod        String               @default("PICKUP") // SHIP|PICKUP
  shippingCents         Int                  @default(0)
  shipAddress1          String?
  shipAddress2          String?
  shipCity              String?
  shipState             String?
  shipZip               String?
  residential           Boolean              @default(true)
  specialInstructions   String?              // customer-provided notes/comments at checkout
  totalCents            Int                  @default(0)
  createdAt             DateTime             @default(now())
  items                 OrderItem[]
  vendorOrders          VendorOrder[]
  discountCodeId        String?
  discountCode          DiscountCode?        @relation(fields: [discountCodeId], references: [id])
  financeTransactions   FinanceTransaction[]
  history                OrderHistoryEntry[]
}

// Audit trail for admin edits to an order (full-order edits, plus fulfill/cancel
// status changes). One row per edit action, storing a JSON array of field-level
// diffs so the admin UI can render a readable timeline of what changed and when.
model OrderHistoryEntry {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  userEmail   String?  // admin who made the change; null if not attributable
  changesJson String   // JSON array of { field, label, oldValue, newValue }
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  size       String?
  color      String?
  quantity   Int
  priceCents Int
}

model DiscountCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String // PERCENT|AMOUNT
  value     Int
  active    Boolean   @default(true)
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
  orders    Order[]
}

model VendorOrder {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id])
  vendor              String
  externalOrderNumber String?
  status              String
  rawResponse         String?
  createdAt           DateTime @default(now())
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  createdAt DateTime @default(now())
}

model FinanceTransaction {
  id          String   @id @default(cuid())
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  type        String
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())
}

model Checkout {
  id        String   @id @default(cuid())
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id])
  email     String?
  cartJson  String
  status    String   @default("ABANDONED") // ABANDONED|RECOVERED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SanMar catalog rows synced from SFTP CSV files
model SanmarCatalogProduct {
  id               String   @id @default(cuid())
  style            String
  colorName        String   @default("")
  sizeName         String   @default("")
  title            String?
  description      String?
  brand            String?
  category         String?
  subcategory      String?
  priceCents       Int      @default(0)
  inventoryQty     Int      @default(0)
  colorSwatchImage String?
  productImage     String?
  weightLbs        Float?
  inventoryKey     String?
  sizeIndex        String?
  rawData          String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([style, colorName, sizeName])
  @@index([style])
  @@index([category])
}

// Tracks each SFTP/SOAP sync operation
model SanmarSyncLog {
  id            String    @id @default(cuid())
  type          String    // CATALOG_SDL | CATALOG_EPDD | INVENTORY_DIP | SOAP_CHECK
  status        String    // RUNNING | SUCCESS | ERROR
  rowsProcessed Int?
  rowsTotal     Int?
  fileSizeBytes Int?
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
}
