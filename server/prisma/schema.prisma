generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Product {
  id               String      @id @default(cuid())
  name             String
  sku              String      @unique
  vendor           String      @default("OTHER")
  vendorIdentifier String?
  brand            String?
  description      String?
  priceCents       Int
  imagesJson       String?   // JSON array of image URLs, in display order
  sizesJson        String?   // JSON array of strings, e.g. ["S","M","L","XL","2XL"]
  colorsJson       String?   // JSON array of strings, e.g. ["Black","White","Navy"]
  sizeChartUrl     String?   // link to a PDF (or image) sizing chart for this product
  upchargeEnabled  Boolean     @default(false) // charge extra for larger sizes (2XL and up)
  upchargeCents    Int         @default(300)
  weightOz         Int?        // shipping weight in ounces; falls back to a default estimate when unset
  orderItems       OrderItem[]
  shops            Shop[]      @relation("ShopProducts")
  createdAt        DateTime    @default(now())

  // Optional link from an adult-sized product to its youth-sized counterpart
  // (SanMar sells these as entirely separate styles/SKUs — e.g. PC61 vs
  // PC61Y — so they stay separate Products here too; this just lets the
  // storefront offer an Adult/Youth toggle on one page instead of the
  // shopper having to find the other listing themselves). The FK lives on
  // the adult side; onDelete: SetNull so deleting the youth product just
  // drops the link rather than blocking the delete. Many-to-one: the same
  // youth product (e.g. a generic youth tee) can be the youth counterpart
  // of several different adult products, same as one adult product can be
  // offered across many shops — so adultProducts is a list, not a single
  // back-reference. See pickYouthPricingContext() in utils/pricing.ts for
  // how youthPriceCents resolves when a youth product has more than one
  // parent adult.
  youthProductId   String?
  youthProduct     Product?    @relation("AdultYouthLink", fields: [youthProductId], references: [id], onDelete: SetNull)
  adultProducts    Product[]   @relation("AdultYouthLink")

  // The price actually charged for the linked youth variant above, in cents.
  // null (the default, and what every existing link now resolves to) means
  // "mirror this product's own priceCents" — the youth version costs
  // whatever the admin has this adult product priced at, and stays in sync
  // automatically if that price changes. Set only when the admin
  // deliberately wants the youth size to cost something different. This is
  // NOT the same thing as youthProduct.priceCents, which is that other
  // Product row's own raw price field (e.g. left over from a SanMar import
  // at wholesale cost) and is never read for money purposes — see
  // resolveProductPriceCents() in utils/pricing.ts, the one place this gets
  // resolved into what a customer is actually shown and charged.
  youthPriceCents  Int?

  // Admin-defined customization options a shopper fills in/picks on this
  // product's page — e.g. a free-text "Name" field, or a "Design" choice
  // with a few named options (optionally each with its own photo). See
  // ProductVariation below.
  variations       ProductVariation[]

  @@index([vendor])
}

// One customer-facing customization option on a product — e.g. "Hood Number"
// (free text, +$5), "Name" (free text, no charge), or "Design" (a choice of
// a few named options, each optionally with its own photo). A product can
// have any number of these, each independently required/optional and
// independently priced. See OrderItemVariation for how a shopper's actual
// selection is captured and snapshotted onto an order line.
model ProductVariation {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String                    // admin's label for this option, e.g. "Hood Number", "Design"
  type        String   @default("TEXT") // TEXT (shopper types a value) | CHOICE (shopper picks one of choices below)
  required    Boolean  @default(false)  // must the shopper fill this in/pick one before adding to cart
  priceCents  Int      @default(0)      // extra charge when the shopper provides/selects this (TEXT) — ignored for CHOICE, where each choice can carry its own price via... see note on ProductVariationChoice
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  choices     ProductVariationChoice[]
  orderItemVariations OrderItemVariation[]

  @@index([productId])
}

// One selectable option within a CHOICE-type ProductVariation — e.g. "Design
// A" with a photo showing what it looks like. Not used for TEXT-type
// variations.
model ProductVariationChoice {
  id          String   @id @default(cuid())
  variationId String
  variation   ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  label       String
  imageUrl    String?
  priceCents  Int      @default(0) // extra charge for picking this specific choice, on top of the variation's own priceCents
  sortOrder   Int      @default(0)

  @@index([variationId])
}

model Shop {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  active           Boolean    @default(true)
  archived         Boolean    @default(false) // tucked out of the main Shops list into the Archived tab; distinct from active/inactive
  shippingEnabled  Boolean    @default(true) // whether customers may choose "Ship to you" for this shop
  offlinePaymentEnabled Boolean @default(true) // whether customers may choose "Pay at pickup" (cash/check) for this shop
  expiresAt        DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  orders           Order[]
  checkouts        Checkout[]
  products         Product[]  @relation("ShopProducts")
  vendorOrders     VendorOrder[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id                    String               @id @default(cuid())
  shopId                String?
  shop                  Shop?                @relation(fields: [shopId], references: [id])
  orderGroupId          String?              // shared by orders split across shops from one multi-shop checkout
  customerId            String?
  customer              Customer?            @relation(fields: [customerId], references: [id])
  status                String               @default("UNFULFILLED") // UNFULFILLED|FULFILLED|CANCELLED
  paymentStatus         String               @default("UNPAID")      // UNPAID|PAID|OFFLINE_PENDING
  paymentMethod         String?                                       // stripe|cash|check
  stripePaymentIntentId String?
  customerName          String
  customerEmail         String
  shippingMethod        String               @default("PICKUP") // SHIP|PICKUP
  shippingCents         Int                  @default(0)
  // Sales tax calculated via Stripe Tax at checkout time (both card and
  // cash/check/pickup orders — tax is owed regardless of payment method).
  // stripeTaxCalculationId/stripeTaxTransactionId trace back to the Stripe
  // Tax Calculation/Transaction so a future refund/cancellation can be
  // reversed there too. See server/src/utils/tax.ts.
  taxCents               Int                  @default(0)
  stripeTaxCalculationId String?
  stripeTaxTransactionId String?
  shipAddress1          String?
  shipAddress2          String?
  shipCity              String?
  shipState             String?
  shipZip               String?
  residential           Boolean              @default(true)
  specialInstructions   String?              // customer-provided notes/comments at checkout
  totalCents            Int                  @default(0)
  createdAt             DateTime             @default(now())
  // Purchased Shippo shipping label (set by POST /orders/:id/shipping-label).
  // labelUrl is a hosted, print-ready PDF; transactionId lets a future refund/void
  // flow reference it back to Shippo. All null until a label has been bought.
  shippingLabelUrl        String?
  shippingLabelPurchasedAt DateTime?
  shippingTrackingNumber  String?
  shippingCarrier         String?
  shippingService         String?
  shippingTransactionId   String?
  items                 OrderItem[]
  vendorOrders          VendorOrder[]
  discountCodeId        String?
  discountCode          DiscountCode?        @relation(fields: [discountCodeId], references: [id])
  financeTransactions   FinanceTransaction[]
  history                OrderHistoryEntry[]

  @@index([shopId])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([createdAt])
}

// Audit trail for admin edits to an order (full-order edits, plus fulfill/cancel
// status changes). One row per edit action, storing a JSON array of field-level
// diffs so the admin UI can render a readable timeline of what changed and when.
model OrderHistoryEntry {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  userEmail   String?  // admin who made the change; null if not attributable
  changesJson String   // JSON array of { field, label, oldValue, newValue }
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  size       String?
  color      String?
  quantity   Int
  priceCents Int // unit price already includes every selected variation's addon charge below

  variations OrderItemVariation[]

  @@index([orderId])
  @@index([productId])
}

// A shopper's actual answer for one ProductVariation on one order line —
// e.g. "Hood Number: 99" or "Design: Camo (choice)". Snapshotted (name/type/
// priceCents copied in at order time, variationId nullable via SetNull) so
// the order's own record stays accurate even if the admin later renames,
// reprices, or deletes the underlying ProductVariation/choice.
model OrderItemVariation {
  id             String   @id @default(cuid())
  orderItemId    String
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variationId    String?
  variation      ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  name           String   // snapshot of the variation's name at order time
  type           String   // snapshot of TEXT | CHOICE
  textValue      String?  // the shopper's typed value, for TEXT
  choiceLabel    String?  // the chosen option's label, for CHOICE
  choiceImageUrl String?  // the chosen option's photo, if it had one
  priceCents     Int      @default(0) // the addon charge actually applied

  @@index([orderItemId])
}

model DiscountCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String // PERCENT|AMOUNT
  value     Int
  active    Boolean   @default(true)
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
  orders    Order[]
}

model VendorOrder {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id])
  vendor              String
  externalOrderNumber String?
  status              String
  rawResponse         String?
  shopId              String?             // shop this restock PO was placed for (null = spanned multiple/all shops)
  shop                Shop?    @relation(fields: [shopId], references: [id])
  linesJson           String?             // JSON snapshot of what was actually submitted: [{vendorStyle,color,size,quantity,productNames}]
  totalUnits          Int?
  createdAt           DateTime @default(now())

  @@index([externalOrderNumber])
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  createdAt DateTime @default(now())
}

model FinanceTransaction {
  id          String   @id @default(cuid())
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  type        String
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model Checkout {
  id        String   @id @default(cuid())
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id])
  email     String?
  cartJson  String
  status    String   @default("ABANDONED") // ABANDONED|RECOVERED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

// SanMar catalog rows synced from SFTP CSV files
model SanmarCatalogProduct {
  id               String   @id @default(cuid())
  style            String
  colorName        String   @default("")
  sizeName         String   @default("")
  title            String?
  description      String?
  brand            String?
  category         String?
  subcategory      String?
  priceCents       Int      @default(0)
  inventoryQty     Int      @default(0)
  colorSwatchImage String?
  productImage     String?
  weightLbs        Float?
  inventoryKey     String?
  sizeIndex        String?
  mainframeColor   String?  // SanMar's internal color code (e.g. "LtHtGry") — required by the PO/inventory SOAP APIs, distinct from the display colorName
  rawData          String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([style, colorName, sizeName])
  @@index([style])
  @@index([category])
}

// Tracks each SFTP/SOAP sync operation
model SanmarSyncLog {
  id            String    @id @default(cuid())
  type          String    // CATALOG_SDL | CATALOG_EPDD | INVENTORY_DIP | SOAP_CHECK
  status        String    // RUNNING | SUCCESS | ERROR
  rowsProcessed Int?
  rowsTotal     Int?
  fileSizeBytes Int?
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
}
